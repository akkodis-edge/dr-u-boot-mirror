#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>

/ {
	aliases {
		mmc0 = &usdhc3;
	};

	chosen {
		stdout-path = &uart1;
	};

	reg_usb_otg: reg-usb-otg {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usb_otg>;
		regulator-name = "reg_usb_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio3 22 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	clk_32k_wifi: clk-32k-wifi {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	leds {
    	compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;
		status-green {
			label = "status-green";
			gpios = <&gpio1 20 GPIO_ACTIVE_HIGH>;
		};
		status-red {
			label = "status-red";
			gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
		};
    };

	binman: binman {
		multiple-images;
		itb {
			filename = "u-boot.itb";
			align-size = <4096>;

			fit {
				description = "Configuration to load U-Boot";
				fit,fdt-list = "of-list";
				#address-cells = <1>;
				images {
					uboot {
						arch = "arm";
						compression = "none";
						description = "U-Boot";
						os = "u-boot";
						load = <CONFIG_TEXT_BASE>;
						entry = <CONFIG_TEXT_BASE>;
						type = "firmware";
						uboot-blob {
							filename = "u-boot-nodtb.bin";
							type = "blob-ext";
						};
					};
					@fdt-SEQ {
						compression = "none";
						description = "NAME";
						type = "flat_dt";
					};
				};
				configurations {
					@config-SEQ {
						description = "NAME";
						fdt = "fdt-SEQ";
						firmware = "uboot";
						loadables = "uboot";
					};
				};
			};
		};
	};

	signature {
		required-mode = "any";

		key-datarespons {
			required = "conf";
			algo = "sha256,rsa4096";
			rsa,r-squared = <
				0x130bf445 0xb210e2ce 0xf57fe687
				0x57394736 0x62871837 0x75f4fe88 0x387e555a
				0x189837f0 0x2707b143 0xa899a000 0x1e4dd8cb
				0xeaf34074 0xf3d5f3c7 0x99e4c2eb 0xfc860aa7
				0x0f6b1b9d 0x48d49b2c 0x0d184698 0x362e812d
