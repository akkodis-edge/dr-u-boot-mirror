			key-name-hint = "datarespons";
		};
	};
};

&gpio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio1_hog>;

	can2_stb {
		gpio-hog;
		output-high;
		gpios = <2 GPIO_ACTIVE_HIGH>;
	};

	mcu_rst {
		gpio-hog;
		output-low;
		gpios = <4 GPIO_ACTIVE_HIGH>;
	};

	can2_term {
		gpio-hog;
		output-low;
		gpios = <6 GPIO_ACTIVE_HIGH>;
	};

	can2_en {
		gpio-hog;
		output-low;
		gpios = <9 GPIO_ACTIVE_HIGH>;
	};
};

&gpio2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio2_hog>;

	wl_reg_on {
		gpio-hog;
		output-low;
		gpios = <3 GPIO_ACTIVE_HIGH>;
	};

	bt_reg_on {
		gpio-hog;
		output-low;
		gpios = <4 GPIO_ACTIVE_HIGH>;
	};
};

&gpio3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio3_hog>;

	wl_bat_pwr {
		gpio-hog;
		output-low;
		gpios = <23 GPIO_ACTIVE_HIGH>;
	};

	can1_term {
		gpio-hog;
		output-low;
		gpios = <31 GPIO_ACTIVE_HIGH>;
	};
};


&gpio4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio4_hog>;

	can1_en {
		gpio-hog;
		output-low;
		gpios = <10 GPIO_ACTIVE_HIGH>;
	};

	can1_stb {
		gpio-hog;
		output-high;
		gpios = <11 GPIO_ACTIVE_HIGH>;
	};

	mcu_boot0 {
		gpio-hog;
		output-low;
		gpios = <17 GPIO_ACTIVE_HIGH>;
	};

	can1_wake {
		gpio-hog;
		output-low;
		gpios = <18 GPIO_ACTIVE_HIGH>;
	};

	can2_wake {
		gpio-hog;
		output-low;
		gpios = <19 GPIO_ACTIVE_HIGH>;
	};

	hw_setting_0 {
		gpio-hog;
		input;
		gpios = <21 GPIO_ACTIVE_HIGH>;
	};

	hw_setting_1 {
		gpio-hog;
		input;
		gpios = <22 GPIO_ACTIVE_HIGH>;
	};

	hw_setting_2 {
		gpio-hog;
		input;
		gpios = <23 GPIO_ACTIVE_HIGH>;
	};

	gpo1_en {
		gpio-hog;
		output-low;
		gpios = <24 GPIO_ACTIVE_HIGH>;
	};

	gpo2_en {
		gpio-hog;
		output-low;
		gpios = <25 GPIO_ACTIVE_HIGH>;
	};

	gps_pwr_en {
		gpio-hog;
		output-low;
		gpios = <26 GPIO_ACTIVE_HIGH>;
	};

	wwan_nrst {
		gpio-hog;
		output-high;
		gpios = <27 GPIO_ACTIVE_HIGH>;
	};

};

&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio5_hog>;

	ani1_en {
		gpio-hog;
		output-low;
		gpios = <16 GPIO_ACTIVE_HIGH>;
	};

	ani2_en {
		gpio-hog;
		output-low;
		gpios = <17 GPIO_ACTIVE_HIGH>;
	};
};

&gpio6 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio6_hog>;

	5v_en {
		gpio-hog;
		output-low;
		gpios = <2 GPIO_ACTIVE_HIGH>;
	};
};

&gpio7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio7_hog>;

	lc_en {
		gpio-hog;
		output-low;
		gpios = <13 GPIO_ACTIVE_HIGH>;
	};
};

&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet>;
	phy-mode = "rgmii";
	status = "okay";
	phy-handle = <&arphy>;
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		arphy: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0x0>;
			max-speed = <100>;
			interrupt-parent = <&gpio1>;
			interrupts = <26 IRQ_TYPE_EDGE_FALLING>;
		};
	};
};

&wdog2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	status = "okay";
};

&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	status = "okay";

	pmic: pfuze100@8 {
		compatible = "fsl,pfuze100";
		reg = <0x08>;

		regulators {
			sw1a_reg: sw1ab {
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1875000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			sw1c_reg: sw1c {
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1875000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			sw2_reg: sw2 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			sw3a_reg: sw3a {
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1975000>;
				regulator-boot-on;
				regulator-always-on;
			};

			sw3b_reg: sw3b {
				regulator-min-microvolt = <400000>;
				regulator-max-microvolt = <1975000>;
				regulator-boot-on;
				regulator-always-on;
			};

			sw4_reg: sw4 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			swbst_reg: swbst {
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5150000>;
				regulator-boot-on;
				regulator-always-on;
			};

			snvs_reg: vsnvs {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vref_reg: vrefddr {
				regulator-boot-on;
				regulator-always-on;
			};

			vgen1_reg: vgen1 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1550000>;
			};

			vgen2_reg: vgen2 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1550000>;
			};

			vgen3_reg: vgen3 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vgen4_reg: vgen4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vgen5_reg: vgen5 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vgen6_reg: vgen6 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&reg_arm {
	vin-supply = <&sw1a_reg>;
};

&reg_pu {
	vin-supply = <&sw1c_reg>;
};

&reg_soc {
	vin-supply = <&sw1c_reg>;
};

&snvs_poweroff {
	status = "okay";
};

&snvs_pwrkey {
	status = "okay";
};

&usbh1 {
	status = "okay";
	disable-over-current;
};

&usbotg {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usbotg>;
	status = "okay";
	vbus-supply = <&reg_usb_otg>;
	disable-over-current;
	dr_mode = "host";
};

&usdhc3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc3>;
	bus-width = <8>;
	non-removable;
	no-1-8-v;
	keep-power-in-suspend;
	status = "okay";
};

&iomuxc {
	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT10__UART1_TX_DATA    0x1b0b1
			MX6QDL_PAD_CSI0_DAT11__UART1_RX_DATA    0x1b0b1
		>;
	};

	pinctrl_usbotg: usbotggrp {
		fsl,pins = <
			MX6QDL_PAD_ENET_RX_ER__USB_OTG_ID   0x17059
			/*MX6QDL_PAD_KEY_ROW1__GPIO4_IO09		0x17059*/			/* USB_OTG_OC */
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX6QDL_PAD_SD3_CMD__SD3_CMD     	0x17059
			MX6QDL_PAD_SD3_CLK__SD3_CLK     	0x10059
			MX6QDL_PAD_SD3_DAT0__SD3_DATA0      0x17059
			MX6QDL_PAD_SD3_DAT1__SD3_DATA1      0x17059
			MX6QDL_PAD_SD3_DAT2__SD3_DATA2      0x17059
			MX6QDL_PAD_SD3_DAT3__SD3_DATA3      0x17059
			MX6QDL_PAD_SD3_DAT4__SD3_DATA4      0x17059
			MX6QDL_PAD_SD3_DAT5__SD3_DATA5      0x17059
			MX6QDL_PAD_SD3_DAT6__SD3_DATA6      0x17059
			MX6QDL_PAD_SD3_DAT7__SD3_DATA7      0x17059
			MX6QDL_PAD_SD3_RST__SD3_RESET     	0x17059
		>;
	};

	pinctrl_i2c2: i2c2grp {
		fsl,pins = <
			MX6QDL_PAD_KEY_COL3__I2C2_SCL 0x4001b8b1
			MX6QDL_PAD_KEY_ROW3__I2C2_SDA 0x4001b8b1
		>;
	};

	pinctrl_enet: enetgrp-lb2 {
		fsl,pins = <
			MX6QDL_PAD_ENET_MDIO__ENET_MDIO       0x1b0b0
			MX6QDL_PAD_ENET_MDC__ENET_MDC         0x1b0b0
			MX6QDL_PAD_RGMII_TXC__RGMII_TXC       0x1b0b0
			MX6QDL_PAD_RGMII_TD0__RGMII_TD0       0x1b0b0
			MX6QDL_PAD_RGMII_TD1__RGMII_TD1       0x1b0b0
			MX6QDL_PAD_RGMII_TD2__RGMII_TD2       0x1b0b0
			MX6QDL_PAD_RGMII_TD3__RGMII_TD3       0x1b0b0
			MX6QDL_PAD_RGMII_TX_CTL__RGMII_TX_CTL 0x1b0b0
			MX6QDL_PAD_ENET_REF_CLK__ENET_TX_CLK  0x40000000
			MX6QDL_PAD_RGMII_RXC__RGMII_RXC       0x1b0b0
			MX6QDL_PAD_RGMII_RD0__RGMII_RD0       0x1b0b0
			MX6QDL_PAD_RGMII_RD1__RGMII_RD1       0x1b0b0
			MX6QDL_PAD_RGMII_RD2__RGMII_RD2       0x1b0b0
			MX6QDL_PAD_RGMII_RD3__RGMII_RD3       0x1b0b0
			MX6QDL_PAD_RGMII_RX_CTL__RGMII_RX_CTL 0x1b0b0
			MX6QDL_PAD_ENET_RXD1__GPIO1_IO26      0x1a020 /* Phy IRQ */
		>;
	};

	pinctrl_reg_wwan: regwwangrp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT17__GPIO6_IO03	0x1b0b1			/* GP-PCIE_PWR_nEN (active low) */
		>;
	};

	pinctrl_gpio1_hog: gpio1hoggrp {
		fsl,pins = <
			MX6QDL_PAD_GPIO_2__GPIO1_IO02 0x20 /* CAN2_STB */
			MX6QDL_PAD_GPIO_4__GPIO1_IO04 0x20 /* MCU_RESET (active high) */
			MX6QDL_PAD_GPIO_6__GPIO1_IO06 0x20 /* CAN2_RES */
			MX6QDL_PAD_GPIO_9__GPIO1_IO09 0x20 /* CAN2_EN */
		>;
	};

	pinctrl_gpio2_hog: gpio2hoggrp {
		fsl,pins = <
			MX6QDL_PAD_NANDF_D3__GPIO2_IO03 0x20 /* WL_REG_ON */
			MX6QDL_PAD_NANDF_D4__GPIO2_IO04 0x20 /* BT_REG_ON */
		>;
	};

	pinctrl_gpio3_hog: gpio3hoggrp {
		fsl,pins = <
			MX6QDL_PAD_EIM_D23__GPIO3_IO23 0x20 /* GP--WL_BAT_PWR_EN */
			MX6QDL_PAD_EIM_D31__GPIO3_IO31 0x20 /* GP_CAN1_RES_EN */
		>;
	};

	pinctrl_gpio4_hog: gpio4hoggrp {
		fsl,pins = <
			MX6QDL_PAD_KEY_COL2__GPIO4_IO10   0x20 /* CAN1_EN */
			MX6QDL_PAD_KEY_ROW2__GPIO4_IO11   0x20 /* CAN1_STB */
			MX6QDL_PAD_DI0_PIN15__GPIO4_IO17  0x20 /* MCU Boot select */
			MX6QDL_PAD_DI0_PIN2__GPIO4_IO18   0x20 /* CAN1_WAKE */
			MX6QDL_PAD_DI0_PIN3__GPIO4_IO19	  0x20 /* CAN2_WAKE */
			MX6QDL_PAD_DISP0_DAT0__GPIO4_IO21 0x10020 /* HW Setting 0 */
			MX6QDL_PAD_DISP0_DAT1__GPIO4_IO22 0x10020 /* HW Setting 1 */
			MX6QDL_PAD_DISP0_DAT2__GPIO4_IO23 0x10020 /* HW Setting 2 */
			MX6QDL_PAD_DISP0_DAT3__GPIO4_IO24 0x20 /* GP_EN--GPO1 */
			MX6QDL_PAD_DISP0_DAT4__GPIO4_IO25 0x20 /* GP_EN--GPO2 */
			MX6QDL_PAD_DISP0_DAT5__GPIO4_IO26 0x20 /* GP_EN_PWR--ANT_GPS */
			MX6QDL_PAD_DISP0_DAT6__GPIO4_IO27 0x20 /* GP_nPRST_WWAN */
		>;
	};

	pinctrl_gpio5_hog: gpio5hoggrp {
		fsl,pins = <
			MX6QDL_PAD_DISP0_DAT22__GPIO5_IO16 0x20 /* EN_ANI1 */
			MX6QDL_PAD_DISP0_DAT23__GPIO5_IO17 0x20 /* EN_ANI2 */
		>;
	};

	pinctrl_gpio6_hog: gpio6hoggrp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT16__GPIO6_IO02 0x20 /* GP-EN--BUCK_5V--CPU (active high) */
		>;
	};

	pinctrl_gpio7_hog: gpio7hoggrp {
		fsl,pins = <
			MX6QDL_PAD_GPIO_18__GPIO7_IO13 0x20 /* GP-EN--ISO_UART */
		>;
	};

	pinctrl_leds: ledsgrp {
		fsl,pins = <
			MX6QDL_PAD_SD1_CMD__GPIO1_IO18		0x2070			/* GP_LED_R_STATUS */
			MX6QDL_PAD_SD1_CLK__GPIO1_IO20		0x2070			/* GP_LED_G_STATUS */
		>;
	};

	pinctrl_reg_usb_otg: regusbotggrp {
		fsl,pins = <
			MX6QDL_PAD_EIM_D22__GPIO3_IO22	0x2070 			/* USB_OTG_PWR_EN */
		>;
	};

	pinctrl_wdog: wdoggrp {
		fsl,pins = <
			MX6QDL_PAD_GPIO_1__WDOG2_B		0x1b0b0
		>;
	};
};
